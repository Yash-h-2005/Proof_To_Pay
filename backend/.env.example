# MST Testnet — ProofToPay deployed contract
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com

# Deployed ProofToPay contract address (Phase 3, MST Testnet)
PROOF_TO_PAY_CONTRACT=0x09b9e52dE1B7fd4cD1eC7139275131557dbF5347

# Backend HTTP port
PORT=3001

# CORS — allowed origin for local frontend development
CORS_ORIGIN=http://localhost:5173

# Backend wallet private key (ONLY needed for backend-signed write operations)
# NOTE: Most write operations (createTask, fundTask, etc.) will be signed by BridgeKey in the frontend.
# This key is optional for Phase 4 read-only operation.
BACKEND_PRIVATE_KEY=
