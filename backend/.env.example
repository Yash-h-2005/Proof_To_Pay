# MST Testnet — ProofToPay deployed contract
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com

# Deployed ProofToPay contract address (Phase 3, MST Testnet)
PROOF_TO_PAY_CONTRACT=0x09b9e52dE1B7fd4cD1eC7139275131557dbF5347

# Backend HTTP port (Render automatically provides PORT in production; local default: 3001)
PORT=3001

# CORS allowed origin
# Local: http://localhost:5173
# Render Production: https://<your-vercel-app>.vercel.app (or * to allow public frontend access)
CORS_ORIGIN=http://localhost:5173

# Backend wallet private key (OPTIONAL — only needed if backend itself signs transactions)
# All marketplace write operations (createTask, fundTask, etc.) are signed by user wallet in frontend.
BACKEND_PRIVATE_KEY=

